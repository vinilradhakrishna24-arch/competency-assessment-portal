# =============================================================================
# Competency Assessment Portal — environment variables
#
# Copy this file to .env.local for local development. On Netlify (or any
# other host), set every variable below in the site's environment settings.
#
# SECURITY RULE: anything prefixed NEXT_PUBLIC_ is bundled into the browser
# and is world-readable. Never put a secret, service-role key, or password
# behind a NEXT_PUBLIC_ variable. Everything in the "server-only" section
# below must stay server-only — see src/lib/env.ts, which throws if any of
# them are ever accessed from browser code.
# =============================================================================

# -----------------------------------------------------------------------
# Browser-safe (exposed to the client bundle)
# -----------------------------------------------------------------------

# Supabase project URL. Find it in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key. Safe to expose — Row Level Security (RLS)
# policies on every table are what actually restrict access, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public base URL of this deployment. Used to build candidate exam links
# (e.g. https://your-app.netlify.app/exam/{token}) and certificate QR codes
# (https://your-app.netlify.app/verify/{code}). Must match your real domain
# in production — candidate links are generated using this value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------
# Server-only — NEVER prefix with NEXT_PUBLIC_, never import into a
# component that renders on the client, never log or return in an API
# response.
# -----------------------------------------------------------------------

# Supabase service-role key. Bypasses Row Level Security entirely — used
# only in server-only modules (lib/supabase/admin.ts) for operations that
# must run as a trusted server (candidate exam routes, certificate
# generation, audit logging). Rotate immediately if this ever leaks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection details — only needed if you run migrations
# with a local psql/Supabase CLI workflow instead of the Supabase
# dashboard/Management API. Not read by the running application.
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_PROJECT_REF=your-project-ref

# Dedicated secret used to HMAC-sign the candidate "employee ID verified"
# cookie (see lib/exam/session-cookie.ts). Keep this independent of the
# Supabase keys so either can be rotated without affecting the other.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EXAM_SESSION_SECRET=generate-a-long-random-value-see-comment-above

# -----------------------------------------------------------------------
# Deployment tooling only — read by scripts/CI, never by the running app
# -----------------------------------------------------------------------

# Netlify personal access token, used only by the deployment script/CLI.
NETLIFY_AUTH_TOKEN=your-netlify-token
